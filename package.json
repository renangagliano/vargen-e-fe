{
  "name": "vargen-e-fe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "media:build": "tsc -p tools/instagram-reels/tsconfig.json",
    "media:test": "npm run media:build && node --test tools/instagram-reels/dist/tests/index.test.js",
    "media:doctor": "npm run media:build && node tools/instagram-reels/dist/src/cli/index.js doctor",
    "media:scan": "npm run media:build && node tools/instagram-reels/dist/src/cli/index.js scan",
    "media:list": "npm run media:build && node tools/instagram-reels/dist/src/cli/index.js list",
    "media:inspect": "npm run media:build && node tools/instagram-reels/dist/src/cli/index.js inspect",
    "media:verify": "npm run media:build && node tools/instagram-reels/dist/src/cli/index.js verify"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
