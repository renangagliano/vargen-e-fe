# Public site configuration
NEXT_PUBLIC_SITE_URL=https://vargenefe.com.br
NEXT_PUBLIC_GA_ID=

# Contact/newsletter providers (optional until connected)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=contato@vargenefe.com.br
CONTACT_TO_EMAIL=contato@vargenefe.com.br
NEWSLETTER_ENDPOINT=

# Instagram media foundation (local configuration only; never commit real paths)
# The source root must be the locally synchronized OneDrive folder, not a sharing URL.
VARGEN_MEDIA_ROOT=
# Derived Reels are not created in Phase 2; keep this outside Git.
VARGEN_REELS_OUTPUT_ROOT=
# SQLite/runtime state should be local and outside OneDrive.
VARGEN_PIPELINE_STATE_ROOT=
# Personal Microsoft Graph delegated authentication. Keep the real client ID
# in ignored .env.local; never add tokens or client secrets here.
MICROSOFT_PERSONAL_CLIENT_ID=
MICROSOFT_PERSONAL_AUTHORITY=https://login.microsoftonline.com/consumers
MICROSOFT_PERSONAL_REDIRECT_URI=http://localhost
MICROSOFT_PERSONAL_SCOPES=Files.ReadWrite
# Optional absolute executable paths when the current shell PATH is stale after installation.
FFMPEG_BIN=
FFPROBE_BIN=

# Official Meta publishing configuration. Keep real credentials only in ignored
# .env.local. Instagram Login publication uses the access token and account ID;
# META_APP_SECRET is not used by this project path.
INSTAGRAM_PUBLISH_MODE=dry-run
INSTAGRAM_REQUIRE_APPROVAL=true
INSTAGRAM_TIMEZONE=America/Sao_Paulo
INSTAGRAM_PILOT_REAL=false
INSTAGRAM_TEMP_MEDIA_PROVIDER=
MAX_REELS_PER_DAY=1
MIN_HOURS_BETWEEN_REELS=24
MAX_REELS_PER_SONG_PER_30_DAYS=3
MAX_REELS_PER_COLLECTION_CONSECUTIVELY=2
# Section 8.1: read-only official Meta connectivity validation.
META_GRAPH_API_VERSION=v22.0
META_GRAPH_API_BASE_URL=https://graph.instagram.com
META_CONNECTIVITY_TIMEOUT_MS=15000
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
REEL_SAFE_ZONE_TOP_PX=120
REEL_SAFE_ZONE_BOTTOM_PX=300
REEL_SAFE_ZONE_SIDE_PX=80
MIN_REEL_CANDIDATE_SCORE=65
MIN_REEL_CONFIDENCE=0.65
MAX_REELS_PER_SOURCE=3
MAX_CANDIDATE_OVERLAP_PERCENT=50
VARGEN_ANALYSIS_VERSION=phase6-audio-heuristic-v1
VARGEN_CATALOG_RENDER_VERSION=phase6-catalog-render-v1
VARGEN_CATALOG_EDITORIAL_VERSION=phase6-editorial-v1

# Phase 7 local review cockpit; localhost-only and separate from the public site.
VARGEN_REVIEWER_NAME=
VARGEN_REVIEW_HOST=127.0.0.1
VARGEN_REVIEW_PORT=4177

# Remote admin backend. Publishable keys are browser-safe; secret keys remain
# server-only. Legacy anon/service-role names are supported for compatibility.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_DATA_SOURCE=sqlite
ADMIN_REMOTE_WRITE_ENABLED=false
